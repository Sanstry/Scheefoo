std::string hexToBinary(const std::string& hexString) {
    std::string binaryString;
    for (char c : hexString) {
        int hexValue;
        if (c >= '0' && c <= '9') {
            hexValue = c - '0';
        } else if (c >= 'A' && c <= 'F') {
            hexValue = 10 + (c - 'A');
        } else if (c >= 'a' && c <= 'f') {
            hexValue = 10 + (c - 'a');
        } else {
            // Invalid character
            return "";
        }
        binaryString += std::bitset<4>(hexValue).to_string();
    }
    return binaryString;
}

std::string binaryToHex(const std::string& binaryString) {
    // Make sure the length of the binary string is a multiple of 4
    int padding = binaryString.length() % 4;
    std::string paddedBinaryString = binaryString;
    if (padding != 0) {
        paddedBinaryString = std::string(4 - padding, '0') + paddedBinaryString;
    }

    std::string hexString;
    for (size_t i = 0; i < paddedBinaryString.length(); i += 4) {
        std::string nibble = paddedBinaryString.substr(i, 4); // Get 4-bit substring
        int decimalValue = std::bitset<4>(nibble).to_ulong(); // Convert binary to decimal
        char hexChar = (decimalValue < 10) ? ('0' + decimalValue) : ('A' + (decimalValue - 10)); // Convert decimal to hexadecimal character
        hexString += hexChar;
    }
    return hexString;
}

// Function to apply Rule 105 to update the state of the cellular automaton
std::bitset<48> applyRule30(const std::bitset<48>& currentState) {
    // Rule 105 in binary: 01101001
    std::bitset<8> rule30("00011110");
    std::bitset<48> nextState;

    for (int i = 0; i < 48; ++i) {
        // Get the neighborhood configuration for the current cell and update accordingly
        int leftIndex = (i == 47) ? 0 : i + 1;
        int rightIndex = (i == 0) ? 47 : i - 1;
        std::bitset<3> neighborhood((currentState[leftIndex] << 2) | (currentState[i] << 1) | currentState[rightIndex]);

        // Use the rule to determine the next state
        nextState[i] = rule30[neighborhood.to_ulong()];
    }

    return nextState;
}


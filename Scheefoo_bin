std::string binaryXOR(const std::string& binary1, const std::string& binary2) {
    if (binary1.length() != binary2.length()) {
        std::cerr << "Panjang string biner harus sama." << std::endl;
        return "";
    }

    std::string result = "";
    for (size_t i = 0; i < binary1.length(); i++) {
        result += (binary1[i] == binary2[i] ? '0' : '1');
    }

    return result;
}

vector<string> splitIntoBlocks(const string& binaryString, int blockSize) {
    string paddedBinaryString = binaryString;
    const size_t remainder = paddedBinaryString.length() % blockSize;
    const size_t paddingLength = remainder == 0
        ? static_cast<size_t>(blockSize)
        : static_cast<size_t>(blockSize) - remainder;
    paddedBinaryString += '1';
    paddedBinaryString.append(paddingLength - 1, '0');

    vector<string> blocks;
    string currentBlock;
    // Ambil blok-blok sepanjang blockSize
    for (size_t i = 0; i < paddedBinaryString.length(); i += blockSize) {
        currentBlock = paddedBinaryString.substr(i, blockSize);
        blocks.push_back(currentBlock);
    }

    return blocks;
}

// Fungsi untuk melakukan pergeseran bit ke kiri (shift left) pada string biner
string leftShift(const string& binaryString, int shiftAmount) {
    // Lakukan pergeseran bit
    string shiftedString = binaryString.substr(shiftAmount) + binaryString.substr(0, shiftAmount);
    
    return shiftedString;
}

string rightShift(const string& binaryString, int shiftAmount) {
    // Lakukan pergeseran bit
    int length = binaryString.length();
    string shiftedString = binaryString.substr(length - shiftAmount) + binaryString.substr(0, length - shiftAmount);
    
    return shiftedString;
}

// Function to perform modular addition on two bitsets
std::bitset<48> modAdd(std::bitset<48> a, std::bitset<48> b, std::bitset<48> modulus) {
    // Perform addition
    unsigned long long sum = a.to_ullong() + b.to_ullong();
    // Perform modular operation
    sum %= modulus.to_ullong();
    // Convert sum back to bitset
    return std::bitset<48>(sum);
}

